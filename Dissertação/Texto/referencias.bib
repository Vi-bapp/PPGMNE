  urldate = {2026-08-12},
  abstract = {The aim of this paper is to develop a virtual element method (VEM) for the vibration problem of thin plates on polygonal meshes. We consider a variational formulation relying only on the transverse displacement of the plate and propose an               H               2               (               \textohm{}               ) conforming discretization by means of the VEM which is simple in terms of degrees of freedom and coding aspects. Under standard assumptions on the computational domain, we establish that the resulting scheme provides a correct approximation of the spectrum and prove optimal order error estimates for the eigenfunctions and a double order for the eigenvalues. Finally, we report several numerical experiments illustrating the behaviour of the proposed scheme and confirming our theoretical results on different families of meshes. Additional examples of cases not covered by our theory are also presented.},
