@article{computingpropertiesdisplacementresponsemultidegreefreedomstructuresdifferentcircumstances2023,
  title = {Computing the {{Properties}} and {{Displacement Response}} of {{Multi-degree}} of {{Freedom Structures}} under {{Different Circumstances}}},
  author = {Zhao, Zongyang and Pan, Qirui and Huang, Yi},
  year = 2023,
