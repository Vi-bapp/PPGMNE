@article{virtualelementmethodgeneralsecondorderellipticproblemspolygonalmeshes2016,
  title = {Virtual {{Element Method}} for General Second-Order Elliptic Problems on Polygonal Meshes},
  author = {Beir{\~a}o Da Veiga, L. and Brezzi, F. and Marini, L. D. and Russo, A.},
  year = 2016,
  month = apr,
